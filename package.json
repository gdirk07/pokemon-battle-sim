{
  "name": "pb-express",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "sync-sprites": "node scripts/sync-sprites.js",
    "predev": "npm run sync-sprites",
    "prebuild": "npm run sync-sprites",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && node --watch --env-file=.env.development index.js",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && node --env-file=.env.production index.js",
    "build:start": "npm run build && npm run start",
    "test": "vitest run",
    "test:backend": "vitest run --dir backend",
    "test:frontend": "vitest run --dir frontend",
    "test:watch": "vitest",
    "test:watch:backend": "vitest --dir backend",
    "test:watch:frontend": "vitest --dir frontend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "pokemon-showdown": "^0.11.10",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.2.5",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  },
  "type": "commonjs"
}
